# Copy to .env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres in production; dev falls back to SQLite when unset.
# DATABASE_URL=postgres://user:pass@localhost:5432/gramin

# Celery. With no Redis running, leave ALWAYS_EAGER true and tasks run inline.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

# AI adapter layer: "local" loads models in-process, "remote" calls a model server.
AI_BACKEND=local
AI_REMOTE_URL=http://localhost:9000

# ASR: small is enough for hi/en; medium improves ta/te at ~2x the latency.
ASR_MODEL_SIZE=small
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8_float16

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
